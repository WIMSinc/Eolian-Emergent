# Environment variables for web/ — the live site.
#
# Real values live only in Vercel (Project Settings -> Environment Variables).
# Nothing secret belongs in this file or anywhere else in the repo; this is a
# checklist of what the app reads and what happens when a value is absent.
#
# NEXT_PUBLIC_* is inlined into the client bundle AT BUILD TIME. Adding or
# changing one requires a redeploy that starts after the value is saved —
# saving alone changes nothing.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, used for absolute URLs in metadata, JSON-LD and the sitemap.
# Differs per environment: https://www.eolianvr.com in production, the preview
# origin otherwise.
PUBLIC_SITE_URL=https://www.eolianvr.com

# ---------------------------------------------------------------------------
# Sanity (blog)
# ---------------------------------------------------------------------------

# Project b4qwtn71 as of 2026-08-25. Must match SANITY_STUDIO_PROJECT_ID in
# studio/.env, and the dataset ACL must stay public — the site reads published
# documents anonymously with no token. lib/sanity.js degrades to an empty blog
# rather than throwing when this is unset, so a missing value never fails a
# production build; it just renders "No posts published yet" with nothing in
# the build log to explain it.
NEXT_PUBLIC_SANITY_PROJECT_ID=b4qwtn71
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# HubSpot
# ---------------------------------------------------------------------------

# Portal ID. Not a secret — it is already public in the page source. Defaults
# to 19544401 in lib/hubspot.js when unset.
HUBSPOT_PORTAL_ID=19544401

# GUIDs of the HubSpot forms the API routes submit to server-side, one per
# website form. Find each in Marketing -> Forms; the GUID is in the editor URL:
#   app.hubspot.com/forms/19544401/editor/<GUID>/edit/form
#
# Not secrets — a form GUID only allows submitting to that form, which is what
# the public internet can already do.
#
# Any GUID left unset silently skips the CRM write for that form and still
# sends the notification email. That is deliberate: the visitor is waiting on
# the email, and a CRM failure should never tell someone their message did not
# send.
#
# Each HubSpot form must define every field the route sends, or HubSpot rejects
# the submission: email, firstname, phone, company, and message where used.
HUBSPOT_CONTACT_FORM_GUID=
HUBSPOT_CATALOG_FORM_GUID=
HUBSPOT_KIT_QUOTE_FORM_GUID=

# ---------------------------------------------------------------------------
# Email notifications (contact, catalog, kit quote)
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form notifications are delivered. Defaults to mike@eolianvr.com.
NOTIFY_EMAIL=mike@eolianvr.com

# ---------------------------------------------------------------------------
# reCAPTCHA
# ---------------------------------------------------------------------------

# Server-side verification for all three form routes. Without it every
# submission is rejected as unverified, so this is required in any environment
# where the forms need to work.
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
# Differs between production and preview: each Stripe webhook endpoint has its
# own signing secret. Using production's secret on a preview deployment makes
# every webhook fail signature verification.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------

# Source maps upload only when SENTRY_AUTH_TOKEN is present, so local builds and
# forks succeed without it — they just ship minified stack traces. The browser
# DSN is committed in instrumentation-client.js; a DSN is a write-only ingest
# endpoint, not a credential.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
